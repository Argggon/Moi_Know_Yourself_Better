{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoiAskedQuestionsHistory",
  "description": "Historical record of asked questions and fingerprints to enforce 0 duplicates and 3:3:1 depth balancing.",
  "type": "object",
  "properties": {
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "question_en": { "type": "string" },
          "question_zh": { "type": "string" },
          "depth_level": { 
            "type": "string", 
            "enum": ["light", "medium", "deep"],
            "description": "light=1/2 min thought (weather, simple preference); medium=values, daily decisions; deep=core identity, childhood, philosophical"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Category tags (e.g. ['sensory', 'weather'], ['work', 'boundaries'], ['identity', 'past'])"
          },
          "semantic_fingerprint": {
            "type": "string",
            "description": "Core intent hash or summary sentence for fast semantic comparison."
          }
        },
        "required": ["id", "date", "question_zh", "depth_level", "tags", "semantic_fingerprint"]
      }
    }
  }
}
